# Django設定
SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=project.prod_settings

# データベース設定
DATABASE_URL=postgresql://user:password@host:port/dbname

# 許可ホスト
ALLOWED_HOSTS=api.luggo.delivery

# Django Admin URL
# ALB の IP 制限ルールも、このパスに合わせて更新すること
DJANGO_ADMIN_PATH=luggo-ops-change-me

# CORS設定
CORS_ALLOWED_ORIGINS=https://luggo.delivery,https://www.luggo.delivery

# CSRF設定
CSRF_TRUSTED_ORIGINS=https://luggo.delivery,https://www.luggo.delivery

# フロントエンド URL
FRONTEND_BASE_URL=https://luggo.delivery

# メール設定
DEFAULT_FROM_EMAIL=noreply@luggo.delivery
PLATFORM_FROM_DISPLAY_NAME=LugGo(ラグゴー)

# Resend設定
RESEND_API_KEY=re_xxx

# 運営への通知先メールアドレス（カンマ区切りで複数指定可）
OPERATIONS_NOTIFICATION_EMAIL=ops@luggo.delivery

# 事業者向け月次請求書・支払明細設定
PLATFORM_INVOICE_ISSUER_NAME=LugGo（ラグゴー）運営事務局
PLATFORM_INVOICE_ISSUER_ADDRESS=東京都千代田区千代田1-1
# 適格請求書発行事業者登録番号（T + 数字13桁）。未設定または形式不正なら番号なしで発行
PLATFORM_INVOICE_REGISTRATION_NUMBER=
PLATFORM_INVOICE_SEAL_PATH=business_owners/assets/platform_seal.png

# Stripe設定
STRIPE_SECRET_KEY=sk_live_xxx
# 親アカウント用 Webhook Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 連結アカウント用 Webhook Signing secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# Webhook で「予約なし」と判定する前にフロントの予約作成完了を待つ猶予秒数
STRIPE_WEBHOOK_BOOKING_GRACE_SECONDS=10

# Google Places API Key
GOOGLE_PLACES_API_KEY=AIza_xxx

# Google Geocoding API Key
GOOGLE_GEOCODING_API_KEY=AIza_xxx

# Google Routes API Key
GOOGLE_ROUTES_API_KEY=AIza_xxx

# Turnstile Secret Key
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# 公開 API のレート制限
# レートは「回数/期間」形式（期間: s, min, hour, day）
THROTTLE_ENABLED=True
THROTTLE_LOGIN_RATE=10/min
THROTTLE_EMAIL_SEND_RATE=20/hour
THROTTLE_PUBLIC_READ_RATE=30/min
THROTTLE_PAYMENT_RATE=20/min

# 日次自動割当
CELERY_BROKER_URL=redis://redis-host:6379/0
CELERY_RESULT_BACKEND=redis://redis-host:6379/1
ROUTING_MAX_BOOKINGS=1000
ROUTING_MAX_TASKS=2000
ROUTING_MAX_DRIVERS=200
ROUTING_MAX_ADVANCE_DAYS=90
ROUTING_ASSIGNMENT_TIME_LIMIT_SECONDS=60

# 配達者ごとの訪問ルート生成（距離行列キャッシュ・レート制限）
ROUTING_CACHE_URL=redis://redis-host:6379/2
ROUTING_MATRIX_ELEMENTS_PER_MINUTE=3000
ROUTING_MATRIX_CACHE_SECONDS=300

# Sentry（エラー監視）。未設定の場合は無効
SENTRY_DSN=

# AWS / S3設定
AWS_STORAGE_BUCKET_NAME=luggo-storage
AWS_S3_REGION_NAME=ap-northeast-3
# ローカルから本番バケットを触るときだけキーを設定
# AWS_ACCESS_KEY_ID=AKIA_xxx
# AWS_SECRET_ACCESS_KEY=xxx