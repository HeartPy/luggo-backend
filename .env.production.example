# Django設定
SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=project.prod_settings

# データベース設定
DATABASE_URL=postgresql://user:password@host:port/dbname

# 許可ホスト
ALLOWED_HOSTS=api.your-domain.prod

# CORS設定（フロントエンドURL）
CORS_ALLOWED_ORIGINS=https://your-domain.prod

# メール設定
DEFAULT_FROM_EMAIL=noreply@your-domain.prod
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Resend設定
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@your-domain.prod

# 運営への通知先メールアドレス（カンマ区切りで複数指定可）
OPERATIONS_NOTIFICATION_EMAIL=ops@your-domain.prod

# Stripe設定
STRIPE_SECRET_KEY=sk_live_xxx
# Stripe ダッシュボードの Webhook エンドポイントで発行される Secret Key
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Webhook で「予約なし」と判定する前にフロントの予約作成完了を待つ猶予秒数
STRIPE_WEBHOOK_BOOKING_GRACE_SECONDS=10

# Google Places API Key
GOOGLE_PLACES_API_KEY=

# Google Geocoding API Key
GOOGLE_GEOCODING_API_KEY=

# Google Routes API Key
GOOGLE_ROUTES_API_KEY=

# 日次自動割当
CELERY_BROKER_URL=redis://redis-host:6379/0
CELERY_RESULT_BACKEND=redis://redis-host:6379/1
ROUTING_MAX_BOOKINGS=1000
ROUTING_MAX_TASKS=2000
ROUTING_MAX_DRIVERS=200
ROUTING_MAX_ADVANCE_DAYS=90
ROUTING_ASSIGNMENT_TIME_LIMIT_SECONDS=60

# 配達者ごとの訪問ルート生成（距離行列キャッシュ・レート制限）
ROUTING_CACHE_URL=redis://redis-host:6379/2
ROUTING_MATRIX_ELEMENTS_PER_MINUTE=3000
ROUTING_MATRIX_CACHE_SECONDS=300

# AWS設定
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=luggo-storage
AWS_S3_REGION_NAME=ap-northeast-1
