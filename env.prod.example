# Django設定
SECRET_KEY=luggo-dev-secret-key-change-in-production

# データベース設定
DATABASE_URL=postgresql://user:password@host:port/dbname

# 許可ホスト
ALLOWED_HOSTS=api.your-domain.prod

# CORS設定（フロントエンドURL）
CORS_ALLOWED_ORIGINS=https://your-domain.prod

# メール設定
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@sample.com

# AWS設定
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=luggo-storage
AWS_S3_REGION_NAME=ap-northeast-1

# Resend設定
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@your-domain.prod

# 運営への通知先メールアドレス（カンマ区切りで複数指定可）
OPERATIONS_NOTIFICATION_EMAIL=ops@your-domain.prod
