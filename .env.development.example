# Django設定
SECRET_KEY=django-insecure-xxx
DJANGO_SETTINGS_MODULE=project.settings

# メール設定
DEFAULT_FROM_EMAIL=noreply@sample.com

# Resend設定
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@sample.com

# 運営への通知先メールアドレス（カンマ区切りで複数指定可）
OPERATIONS_NOTIFICATION_EMAIL=ops@sample.com

# Stripe設定
STRIPE_SECRET_KEY=sk_test_xxx
# `stripe listen --forward-to localhost:8000/api/bookings/stripe/webhook` で取得した値
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Webhook で「予約なし」と判定する前にフロントの予約作成完了を待つ猶予秒数
STRIPE_WEBHOOK_BOOKING_GRACE_SECONDS=10

# E2E テスト用: 1 のとき Stripe をモックする（DEBUG 時のみ有効）
# docker compose の場合: E2E_STRIPE_MOCK=1 docker compose up -d backend
E2E_STRIPE_MOCK=

# Google Places API Key
GOOGLE_PLACES_API_KEY=

# Google Geocoding API Key
GOOGLE_GEOCODING_API_KEY=

# Google Routes API Key
GOOGLE_ROUTES_API_KEY=

# 日次自動割当
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
ROUTING_MAX_BOOKINGS=1000
ROUTING_MAX_TASKS=2000
ROUTING_MAX_DRIVERS=200
ROUTING_MAX_ADVANCE_DAYS=90
ROUTING_ASSIGNMENT_TIME_LIMIT_SECONDS=60

# 配達者ごとの訪問ルート生成（距離行列キャッシュ・レート制限）
ROUTING_CACHE_URL=redis://localhost:6379/2
ROUTING_MATRIX_ELEMENTS_PER_MINUTE=3000
ROUTING_MATRIX_CACHE_SECONDS=300
