# Django設定
SECRET_KEY=django-insecure-xxx
DJANGO_SETTINGS_MODULE=project.settings

# 許可ホスト
ALLOWED_HOSTS=localhost,127.0.0.1

# Django Admin URL
#ローカルは admin のままで可
DJANGO_ADMIN_PATH=admin

# CORS設定
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CSRF設定
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# フロントエンド URL
FRONTEND_BASE_URL=http://localhost:3000

# メール設定
DEFAULT_FROM_EMAIL=noreply@luggo.delivery
PLATFORM_FROM_DISPLAY_NAME=LugGo(ラグゴー)

# Resend設定
RESEND_API_KEY=

# 運営への通知先メールアドレス（カンマ区切りで複数指定可）
OPERATIONS_NOTIFICATION_EMAIL=ops@luggo.delivery

# 事業者向け月次請求書・支払明細設定
PLATFORM_INVOICE_ISSUER_NAME=LugGo（ラグゴー）運営事務局
PLATFORM_INVOICE_ISSUER_ADDRESS=東京都千代田区千代田1-1
# 適格請求書発行事業者登録番号（T + 数字13桁）。未設定または形式不正なら番号なしで発行
PLATFORM_INVOICE_REGISTRATION_NUMBER=
PLATFORM_INVOICE_SEAL_PATH=business_owners/assets/platform_seal.png

# Stripe設定
STRIPE_SECRET_KEY=sk_test_xxx
# `stripe listen --forward-to localhost:8000/api/bookings/stripe/webhook` で取得した値
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Webhook で「予約なし」と判定する前にフロントの予約作成完了を待つ猶予秒数
STRIPE_WEBHOOK_BOOKING_GRACE_SECONDS=10

# E2E テスト用（DEBUG 時のみ有効。普段は空のまま、E2E 実行時だけコマンドで渡す）
# docker compose の場合:
#   E2E_STRIPE_MOCK=1 E2E_LOGIN_CODE_MOCK=1 docker compose up -d backend
E2E_STRIPE_MOCK=
E2E_LOGIN_CODE_MOCK=

# Google Places API Key
GOOGLE_PLACES_API_KEY=AIza_xxx

# Google Geocoding API Key
GOOGLE_GEOCODING_API_KEY=AIza_xxx

# Google Routes API Key
GOOGLE_ROUTES_API_KEY=AIza_xxx

# Turnstile Secret Key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 公開 API のレート制限
# 手元で動作確認するときだけ True にする
# レートは「回数/期間」形式（期間: s, min, hour, day）
THROTTLE_ENABLED=
THROTTLE_LOGIN_RATE=10/min
THROTTLE_EMAIL_SEND_RATE=20/hour
THROTTLE_PUBLIC_READ_RATE=30/min
THROTTLE_PAYMENT_RATE=20/min

# 日次自動割当
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
ROUTING_MAX_BOOKINGS=1000
ROUTING_MAX_TASKS=2000
ROUTING_MAX_DRIVERS=200
ROUTING_MAX_ADVANCE_DAYS=90
ROUTING_ASSIGNMENT_TIME_LIMIT_SECONDS=60

# 配達者ごとの訪問ルート生成（距離行列キャッシュ・レート制限）
ROUTING_CACHE_URL=redis://localhost:6379/2
ROUTING_MATRIX_ELEMENTS_PER_MINUTE=3000
ROUTING_MATRIX_CACHE_SECONDS=300
